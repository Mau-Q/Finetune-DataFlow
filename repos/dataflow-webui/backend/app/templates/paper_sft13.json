        "params": {
          "init": [
            {
              "name": "filter_rules",
              "value": "lambda df: df['question'].fillna('').astype(str).str.strip().ne('') & df['answer'].fillna('').astype(str).str.strip().ne('')"
            }
          ],
          "run": []
        }
      },
      {
