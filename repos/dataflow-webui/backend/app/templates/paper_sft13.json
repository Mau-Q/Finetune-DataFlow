          1890,
          160
        ],
        "pipeline_role": "将每个 QA 对展开成独立样本，并提取 question 字段。",
        "params": {
          "init": [
            {
              "name": "process_fn",
              "value": "lambda df: df.explode('QA_pairs', ignore_index=True).assign(question=lambda d: d['QA_pairs'].map(lambda q: q.get('question', '') if isinstance(q, dict) else ''))"
            }
          ],
          "run": [
            {
              "name": "output_key",
              "value": "question"
            }
          ]
        }
      },
      {
        "name": "PandasOperator",
        "location": [
          2200,
          160
        ],
        "pipeline_role": "从已展开的 QA 对中提取 answer 字段。",
        "params": {
          "init": [
            {
              "name": "process_fn",
              "value": "lambda df: df.assign(answer=lambda d: d['QA_pairs'].map(lambda q: q.get('answer', '') if isinstance(q, dict) else ''))"
            }
          ],
          "run": [
            {
              "name": "output_key",
              "value": "answer"
            }
          ]
        }
      },
      {
        "name": "GeneralFilter",
