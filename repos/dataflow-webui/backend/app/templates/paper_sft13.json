          "init": [],
          "run": [
            {
              "name": "input_keys",
              "value": [
                "question",
                "answer"
              ]
            },
            {
              "name": "output_key",
              "value": "hash_deduplicated_label"
            }
          ]
        }
      },
      {
        "name": "PandasOperator",
        "location": [
          4060,
          160
        ],
        "pipeline_role": "将通过筛选的记录整理为 instruction、input、output 训练格式。",
        "params": {
          "init": [
