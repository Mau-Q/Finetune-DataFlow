            },
            {
              "name": "output_key",
              "value": "AlpagasusScore"
            }
          ]
        }
      },
      {
        "name": "GeneralFilter",
        "location": [
          3440,
          160
        ],
        "pipeline_role": "仅保留五项质量评分均至少为 4 分的候选样本。",
        "params": {
          "init": [
            {
              "name": "filter_rules",
              "value": "lambda df: (df['question_quality_grades'] >= 4) & (df['answer_alignment_grades'] >= 4) & (df['answer_verifiability_grades'] >= 4) & (df['downstream_value_grades'] >= 4) & (df['AlpagasusScore'] >= 4)"
            }
          ],
          "run": []
        }
      },
      {
        "name": "HashDeduplicateFilter",
        "location": [
          3750,
          160
        ],
        "pipeline_role": "按问题与答案的组合删除重复 QA，避免产生重复训练样本。",
