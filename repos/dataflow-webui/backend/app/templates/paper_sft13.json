              "name": "process_fn",
              "value": "lambda df: df.assign(instruction=lambda d: d.get('question', ''), input=lambda d: d.get('raw_chunk', ''), output=lambda d: d.get('answer', ''))"
            }
          ],
          "run": [
            {
              "name": "output_key",
              "value": "instruction"
            }
